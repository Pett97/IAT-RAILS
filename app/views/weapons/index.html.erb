<p style="color: green"><%= notice %></p>

<% content_for :title, "Weapons" %>

<h1>Armas</h1>
<table>
  <thead>
    <th>#</th>
    <th>Numero Registro</th>
    <th>Numero Serie</th>
    <th>Calibre</th>
    <th>Marca</th>
    <th>Sistema Registro</th>
    <th>Status</th>
    <th>Ações</th>
  </thead>
  <tbody>
<div id="weapons">
  <% @weapons.each do |weapon| %>
  <tr>
  <td><%= weapon.id%></td>
  <td><%= weapon.number_craf%></td>
  <td><%= weapon.serie_number%></td>
  <td><%= weapon.caliber&.name || "N/A"%></td>
  <td><%= weapon.brand&.name || "N/A"%></td>
  <td>
  <%= SystemRegisterOptions::EXTENDED_SYSTEMSREGISTERS[weapon.system_register&.to_sym] || "Não definido" %></td>
  <td><%= weapon.active ? "Ativa": "Desativada"%></td>    
    <td> <%= link_to "Visualizar", weapon_path(weapon.id) %></td>
  <% end %>
  </tr>
</div>
  </tbody>
</table>


<%= link_to "New weapon", new_weapon_path %>
